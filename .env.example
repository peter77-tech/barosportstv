# TheSportsDB API key. Local only -- never commit this file.
# How to get one, and what CI uses: see README.md
SPORTSDB_KEY=3

# Optional. Uncomment to override.
# Free key (3) throttles hard at the default 90.
#PREBAKE_PER_MINUTE=25
#PREBAKE_TEAM_CAP=60

# WordPress (barosportstv.com) REST — 페이지 생성 등 관리 작업용. 코드는 읽지 않는다(손으로 돌리는 스크립트용).
# WP_USER 는 로그인 아이디다. 애플리케이션 비밀번호에 붙인 「이름」이 아니다 — 넣으면 401 rest_not_logged_in.
# WP_APP_PASSWORD 는 「사용자 → 프로필 → 애플리케이션 비밀번호」에서 발급한 값(공백 포함 그대로).
#WP_URL=https://barosportstv.com
#WP_USER=
#WP_APP_PASSWORD=
