# ══════════════════════════════════════════════════════════════
#  바로스포츠티비 — 로컬 프리베이크 설정
# ══════════════════════════════════════════════════════════════
#  이 파일을 `.env` 로 복사해서 쓰십시오.  cp .env.example .env
#
#  🔴 `.env` 는 커밋되지 않습니다(.gitignore). 저장소가 **공개**이므로
#     `git add -f` 로 강제 추가하지 마십시오 — 키가 그대로 노출됩니다.
#
#  이 값들은 `npm run prebake` 만 씁니다. 브라우저 코드는 키를 모릅니다.
#  (프리베이크가 만든 data/**.json 만 읽습니다)
# ══════════════════════════════════════════════════════════════

# ── 필수 ──────────────────────────────────────────────────────
#  TheSportsDB API 키.
#  발급: https://www.thesportsdb.com/ → 로그인 → Account → API Key
#
#  `3` 은 누구나 쓰는 무료 테스트 키입니다. 검증은 되지만 누적 쿼터가 있어
#  429 가 늘고 데이터가 들쭉날쭉합니다. 유료 키를 받으면 이 줄을 바꾸십시오.
SPORTSDB_KEY=3

# ── 선택 (지우면 기본값) ──────────────────────────────────────
#  분당 호출 수. 기본 90.
#  ⚠️ 무료 키(3)로 검증할 때는 25 정도로 낮추십시오 — 90 이면 429 가 쏟아집니다.
#PREBAKE_PER_MINUTE=25

#  구울 팀 수 상한. 기본 60.
#  올리면 팀 허브·대시보드가 커버하는 팀이 늘고 호출 수도 그만큼 늘어납니다.
#PREBAKE_TEAM_CAP=60
