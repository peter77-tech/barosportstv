# 빌드 도구 (재설치 가능 — npm install)
node_modules/

# 빌드 산출물. assets/tailwind.css 는 배포에 필요하므로 제외하지 않는다.

# 프리베이크 산출물 (CI 에서 매 배포마다 새로 만든다 — 커밋하지 않는다)
data/

# 배포 산출물 (워크플로가 만든다)
_site/

# 키가 담길 수 있는 파일. 저장소가 공개이므로 절대 커밋하지 않는다.
# (코드는 .env 를 읽지 않는다 — 키는 CI 는 Secret, 로컬은 `SPORTSDB_KEY=... npm run prebake` 로 준다)
.env
.env.*
# 양식은 저장소에 남긴다 (키가 없다). ⚠️ .gitignore 는 줄 끝 주석을 못 읽는다 —
# 주석을 이 줄처럼 따로 떼어야 아래 예외가 먹는다.
!.env.example
