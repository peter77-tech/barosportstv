{
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  },
  "name": "arena-live",
  "private": true,
  "description": "ARENA LIVE 정적 사이트 — Tailwind 빌드",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "test": "node --test tests/*.test.mjs",
    "test:php": "php tests/php/run.php",
    "prebake": "node --env-file-if-exists=.env tools/prebake.mjs",
    "prebake:quick": "node --env-file-if-exists=.env tools/prebake.mjs --quick",
    "review": "node --env-file-if-exists=.env tools/review/run.mjs",
    "review:dry": "node --env-file-if-exists=.env tools/review/run.mjs --dry"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
